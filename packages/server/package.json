{
  "name": "@keke/server",
  "version": "0.0.0",
  "private": true,
  "description": "Authoritative Colyseus game server on Express; also serves the built client.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node --enable-source-maps dist/index.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@colyseus/core": "^0.18.27",
    "@colyseus/ws-transport": "^0.18.4",
    "@keke/shared": "0.0.0",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@colyseus/sdk": "^0.18.9",
    "@colyseus/testing": "^0.18.6",
    "@colyseus/tools": "^0.18.11",
    "@types/express": "^5.0.6",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15"
  }
}
