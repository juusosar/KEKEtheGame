{
  "name": "keke",
  "version": "0.0.0",
  "private": true,
  "description": "KEKE the Game: chaotic multiplayer browser brawler in a wholesale store",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "dev": "node scripts/stub.mjs dev \"server watch + Vite dev server (M0-3, M0-4)\"",
    "build": "npm run build --workspaces --if-present",
    "start": "node scripts/stub.mjs start \"run the built server (M0-3)\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/stub.mjs test:e2e \"Playwright e2e harness (M0-5)\"",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  }
}
