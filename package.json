{
  "name": "keke",
  "version": "0.0.0",
  "private": true,
  "description": "KEKE the Game: chaotic multiplayer browser brawler in a wholesale store",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "workspaces": [
    "packages/shared",
    "packages/server",
    "packages/client"
  ],
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names server,client --prefix-colors yellow,cyan \"npm run dev -w @keke/server\" \"npm run dev -w @keke/client\"",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w @keke/server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright install chromium && playwright test",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "~1.63.0",
    "@types/node": "^20.19.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^4.1.12"
  }
}
